    "    for emotion in os.listdir(split_dir):\n",
    "        emo_dir = os.path.join(split_dir, emotion)\n",
    "        if os.path.isdir(emo_dir):\n",
    "            for fname in os.listdir(emo_dir):\n",
    "                if fname.lower().endswith((\".jpg\", \".jpeg\", \".png\")):\n",
    "                    rows.append({\n",
    "                        \"path\": os.path.join(emo_dir, fname),\n",
    "                        \"label\": emotion.lower(),\n",
